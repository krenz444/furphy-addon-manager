# Per-install state - never commit (contains the addon list, the CurseForge API key, logs and rollback zips)
addons.json
settings.json
state.json
last-run.txt
tray-state.json
server.pid
*.log
jobs/
staging/
backups/
*.zip

# WebView2 runtime cache folder (per-machine junk left next to FurphyHost.exe, not part of the app)
*.WebView2/

# Editor / OS noise
.vs/
.idea/
Thumbs.db
desktop.ini

# WebView2 SDK package (downloaded by host/build-host.ps1; only the extracted DLLs are needed at runtime)
*.nupkg
host/Smoke.exe
host/smoke-result.txt

# Keyless CurseForge catalogue cache (regenerated; never commit)
cache/
tray-state.json
